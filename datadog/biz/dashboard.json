                    {
                      "formula": "q1"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:shipaudit.biz.claim_amount{$carrier,$env} by {claim_status}"
                    }
