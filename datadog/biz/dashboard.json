                        }
                      }
                    }
                  ],
                  "queries": [
                    {
                      "aggregator": "last",
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:shipaudit.biz.claim_amount{claim_status:rejected,$carrier,$env}"
                    }
