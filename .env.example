# Sao chép thành .env và điền giá trị. KHÔNG commit file .env.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB=shipaudit

DD_API_KEY=
# Application key: chỉ cần để tạo / cập nhật dashboard và monitor bằng datadog/*/apply.py
DD_APP_KEY=
# Tổ chức Datadog của đội ở site uk1 (không phải site mặc định datadoghq.com)
DD_SITE=uk1.datadoghq.com
DD_ENV=dev
DD_SERVICE=shipaudit-api
DD_LOGS_INJECTION=true
DD_TRACE_ENABLED=true
# Bọc PyMongo bằng ddtrace: để false cho tới khi có cặp ddtrace/pymongo tương thích (xem app/telemetry/tracing.py)
DD_TRACE_PYMONGO_ENABLED=false
# Không có Datadog Agent (chạy trên máy, không Docker): metric gửi thẳng Metrics API khi có DD_API_KEY
# (tắt bằng DD_METRICS_AGENTLESS=false); đặt DD_LOGS_AGENTLESS=true để gửi log thẳng Logs API.
DD_METRICS_AGENTLESS=true
DD_LOGS_AGENTLESS=false
# Sự kiện claim (tạo nháp, duyệt, gửi hãng, thu hồi) lên Datadog Events, hiện thành vạch trên dashboard. Chỉ cần DD_API_KEY.
SHIPAUDIT_DD_EVENTS=false
# Handle Case Management (vd @case-shipaudit) để monitor gộp tự mở case; dùng khi chạy datadog/biz/apply.py
SHIPAUDIT_CASE_HANDLE=
# Giao diện chỉ xem (bản demo cho giám khảo): ẩn nút tạo claim, duyệt, gửi hãng, ghi nhận thu hồi
SHIPAUDIT_READ_ONLY=false

# Secret để xác thực webhook Datadog gọi về FastAPI
WEBHOOK_SECRET=change-me

# Luồng nạp: nơi lưu file bảng kê, số ngày giữ ingest_events (TTL)
UPLOAD_DIR=data/uploads
INGEST_EVENTS_TTL_DAYS=14

# Công tắc lỗi nạp (A dùng cho kịch bản lớp vận hành)
# ADMIN_TOKEN: nếu đặt, /admin/ingest-fault đòi header X-Admin-Token. Để trống chỉ khi chạy trên máy.
ADMIN_TOKEN=
INGEST_DELAY_MS=0
INGEST_FAIL_RATE=0
